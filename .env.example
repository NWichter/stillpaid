# localnet | devnet | mainnet-beta
SOLANA_CLUSTER=localnet
SOLANA_RPC_URL=http://127.0.0.1:8899
# Classic SPL mint with 6 decimals. Devnet/localnet: the test mint from scripts/setup.ts.
# Mainnet: USDC EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v
MINT=
MINT_SYMBOL=USDC
PUBLIC_URL=http://localhost:4050
PORT=4050
# Optional: app wallet that pays network fees and rent, so users need no SOL.
# It also runs the crank that releases milestones after the review window.
SPONSOR_SECRET_KEY=
SPONSOR_PER_WALLET_PER_HOUR=20
SPONSOR_PER_DAY=500
# Test networks only: the demo counterpart and the mint authority of MINT (test faucet).
DEMO_SECRET_KEY=
TEST_MINT_AUTHORITY=
